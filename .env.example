# Database (MongoDB connection string for serverless mongoose & better-auth)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/trivllo?retryWrites=true&w=majority

# Better Auth Secret (Generate via `openssl rand -base64 32`)
BETTER_AUTH_SECRET=your_better_auth_secret_32_characters_minimum
BETTER_AUTH_URL=http://localhost:3000

# App URLs (CORS & Origin isolation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
VENDOR_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary (Direct unsigned/signed uploads & serverless management)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Bank details encryption key (32 bytes)
BANK_ENCRYPTION_KEY=your_32_character_encryption_key

